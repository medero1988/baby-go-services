{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Baby Go — Provider Store",
    "description": "API store proveedor (base: /api/v1/store).\n\n**Auth:** Bearer {{token}} (role `provider`).\n**Relación 1:1:** un provider = una store. Se resuelve desde el token; no se pasa `storeId`.\n\nFlujo: login → POST /store/profile → cell → avatar → delivery → bank → confirmation → Connect.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Store",
      "item": [
        {
          "name": "1. Obtener mi store",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/store",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store"]
            }
          },
          "response": []
        },
        {
          "name": "1b. Obtener perfil",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/store/profile",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store", "profile"]
            }
          },
          "response": []
        },
        {
          "name": "2. Crear perfil (store)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Baby Confy\",\n  \"country\": \"NL\",\n  \"address\": {\n    \"addressLine1\": \"Seevank 144, 1161 AR Zwanenburg, Netherlands\",\n    \"addressLine2\": \"alguna indicacion extra\",\n    \"placeId\": \"ChIJxxxxxxxxxxxxxxxxxxxx\"\n  },\n  \"cellPhone\": \"+315615628854\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/store/profile",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store", "profile"]
            },
            "description": "Solo una store por provider. Si ya existe → `store_already_exists`."
          },
          "response": []
        },
        {
          "name": "2b. Actualizar perfil (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Baby Confy Updated\",\n  \"address\": {\n    \"addressLine2\": \"nueva indicacion extra\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/store/profile",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store", "profile"]
            }
          },
          "response": []
        },
        {
          "name": "3. Reenviar código (WhatsApp)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/store/cell-verification/resend",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store", "cell-verification", "resend"]
            }
          },
          "response": []
        },
        {
          "name": "4. Validar código celular",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/store/cell-verification",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store", "cell-verification"]
            }
          },
          "response": []
        },
        {
          "name": "5. Subir avatar",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "avatar",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v1/store/avatar",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store", "avatar"]
            },
            "description": "form-data field `avatar` tipo File. Se sube a Cloudinary; `store.avatar` queda con URL HTTPS."
          },
          "response": []
        },
        {
          "name": "6a. Delivery — horario por días",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"available\": true,\n  \"timeRanges\": [\n    \"7:30-9:30\",\n    \"12:30-14:00\",\n    \"17:30-19:00\",\n    \"10:00-15:00\"\n  ],\n  \"days\": {\n    \"mon\": [0, 1, 2],\n    \"tue\": [0, 1],\n    \"sat\": [3]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/store/delivery",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store", "delivery"]
            }
          },
          "response": []
        },
        {
          "name": "6b. Delivery — 24/7",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"available\": true,\n  \"available24h\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/store/delivery",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store", "delivery"]
            }
          },
          "response": []
        },
        {
          "name": "6c. Delivery pricing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"basePrice\": 100,\n  \"priceKm\": 30,\n  \"maxDeliveryDistance\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/store/delivery-pricing",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store", "delivery-pricing"]
            }
          },
          "response": []
        },
        {
          "name": "7a. Customer pickup — horario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"available\": true,\n  \"timeRanges\": [\n    \"7:30-9:30\",\n    \"12:30-14:00\",\n    \"17:30-19:00\",\n    \"10:00-15:00\"\n  ],\n  \"days\": {\n    \"mon\": [0, 1],\n    \"thu\": [2],\n    \"sat\": [3]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/store/customer-pickup",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store", "customer-pickup"]
            }
          },
          "response": []
        },
        {
          "name": "7a. Customer pickup — 24/7",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"available\": true,\n  \"available24h\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/store/customer-pickup",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store", "customer-pickup"]
            }
          },
          "response": []
        },
        {
          "name": "7a. Datos bancarios (payout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountType\": \"IBAN\",\n  \"firstName\": \"Jhon\",\n  \"lastName\": \"Doe\",\n  \"country\": \"NL\",\n  \"currency\": \"eur\",\n  \"iban\": \"NL91ABNA0417164300\",\n  \"bankName\": \"ABN AMRO\",\n  \"swiftCode\": \"ABNANL2A\",\n  \"address\": \"Seevank 144, Zwanenburg\",\n  \"entityType\": \"individual\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/store/bank-account",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store", "bank-account"]
            }
          },
          "response": []
        },
        {
          "name": "7ab. Confirmación final",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"acceptedTerms\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/store/confirmation",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store", "confirmation"]
            }
          },
          "response": []
        },
        {
          "name": "7b. Stripe Connect — account link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"returnUrl\": \"http://localhost:3000/api/stripe-connect/return\",\n  \"refreshUrl\": \"http://localhost:3000/api/stripe-connect/refresh\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/store/stripe-connect/account-link",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store", "stripe-connect", "account-link"]
            }
          },
          "response": []
        },
        {
          "name": "7c. Stripe Connect — sync status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/store/stripe-connect/status",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store", "stripe-connect", "status"]
            }
          },
          "response": []
        },
        {
          "name": "7d. Movimientos de pagos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/store/movements",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store", "movements"],
              "query": [
                {
                  "key": "status",
                  "value": "transferred",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "8. Eliminar store",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/store",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "store"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
