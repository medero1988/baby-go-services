          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "media",
                  "type": "file",
                  "src": [],
                  "description": "Seleccioná una imagen (PNG/JPEG/WEBP/GIF, máx 5MB)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v1/products/{{productId}}/medias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "products",
                "{{productId}}",
                "medias"
              ]
            },
            "description": "Body → form-data → key `media` tipo **File** (no Text).\nSeleccioná un .jpg/.png. Si ves triángulo amarillo, volvé a elegir el archivo.\nNO pongas header Content-Type a mano (Postman arma el boundary).\nCloudinary. Respuesta `{ id, url, width, height, format, bytes, urls: { original, thumbnail, card, detail } }` → guarda `mediaId`."
          },
          "response": []
