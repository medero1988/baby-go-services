{
  "info": {
    "_postman_id": "c3d4e5f6-a7b8-9012-cdef-234567890123",
    "name": "Baby Go — Auth",
    "description": "Auth local + social.\n\nBase: {{baseUrl}} = http://localhost:3000/api\nRutas: /api/v1/auth/...\n\nRequiere RESEND_API_KEY + MAIL_FROM en .env (correos reales).\n\nFlujo local:\n1. POST /account → código al email (copiá `id` → accountId)\n2. POST /email-verification\n3. POST /login → accessToken + refreshToken\n4. GET /account (perfil del token)\n5. POST /access-refresh (rota refresh)\n6. POST /logout\n\nRecovery: password-recovery → código al mail → new-password\n\nVariables: token, refreshToken, accountId",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "accountId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Local",
      "item": [
        {
          "name": "1. Create account (provider)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pepe\",\n  \"lastName\": \"Perez\",\n  \"email\": \"pepe@gmail.com\",\n  \"password\": \"Secret123\",\n  \"role\": \"provider\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/account",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "account"]
            },
            "description": "Crea cuenta local y envía código por Resend. Copiá `id` → accountId.\n`role`: `provider` | `client`."
          },
          "response": []
        },
        {
          "name": "1b. Create account (client)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana\",\n  \"lastName\": \"Lopez\",\n  \"email\": \"ana@gmail.com\",\n  \"password\": \"Secret123\",\n  \"role\": \"client\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/account",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "account"]
            }
          },
          "response": []
        },
        {
          "name": "2. Email verification",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/email-verification",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "email-verification"]
            },
            "description": "Usá el código del email (en dev a veces también viene en logs)."
          },
          "response": []
        },
        {
          "name": "2b. Resend email code",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/resend-email-code",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "resend-email-code"]
            }
          },
          "response": []
        },
        {
          "name": "3. Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pepe@gmail.com\",\n  \"password\": \"Secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            },
            "description": "Copiá `accessToken` → token y `refreshToken` → refreshToken."
          },
          "response": []
        },
        {
          "name": "3b. Get account (JWT)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/account",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "account"]
            },
            "description": "Perfil del usuario autenticado. Requiere Bearer {{token}}."
          },
          "response": []
        },
        {
          "name": "4. Access refresh",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/access-refresh",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "access-refresh"]
            },
            "description": "Rota el refresh: invalida el enviado y devuelve access + refresh nuevos. Actualizá `token` y `refreshToken`."
          },
          "response": []
        },
        {
          "name": "5. Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "logout"]
            },
            "description": "Requiere Bearer + refreshToken en body."
          },
          "response": []
        },
        {
          "name": "6. Password recovery",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pepe@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/password-recovery",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "password-recovery"]
            }
          },
          "response": []
        },
        {
          "name": "6b. Resend password recovery",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pepe@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/resend-password-recovery",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "resend-password-recovery"]
            }
          },
          "response": []
        },
        {
          "name": "7. New password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pepe@gmail.com\",\n  \"recoveryCode\": \"123456\",\n  \"newPassword\": \"NewSecret123\",\n  \"confirmPassword\": \"NewSecret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/new-password",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "new-password"]
            }
          },
          "response": []
        },
        {
          "name": "8. Delete account (JWT)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/account",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "account"]
            },
            "description": "Elimina la cuenta autenticada + refresh tokens + stores del usuario."
          },
          "response": []
        },
        {
          "name": "8b. Delete account by email (solo tests)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pepe@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/account/delete-test",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "account", "delete-test"]
            },
            "description": "Solo NODE_ENV !== production. Borra por email sin JWT."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Social",
      "item": [
        {
          "name": "Google",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"...\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "google"]
            }
          },
          "response": []
        },
        {
          "name": "Facebook",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accessToken\": \"...\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/facebook",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "facebook"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
