                  "    if (pm.environment) pm.environment.set(\"token\", json.accessToken);",
                  "  }",
                  "  if (json.refreshToken) {",
                  "    pm.collectionVariables.set(\"refreshToken\", json.refreshToken);",
                  "    if (pm.environment) pm.environment.set(\"refreshToken\", json.refreshToken);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Logout",
