            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Bearer + body `{ refreshToken }`. Invalida ese refresh."
          },
          "response": []
        },
        {
